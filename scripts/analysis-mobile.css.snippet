/* ==========================================================================
 * ANALYSIS PAGE MOBILE
 * ========================================================================== */
.analysis-page {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  overflow-x: clip;
}
.analysis-page * {
  box-sizing: border-box;
}
.analysis-page-header {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-4);
}
.analysis-page-header h1 {
  margin: 0;
  font-size: clamp(1.15rem, 4vw, 1.5rem);
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.25;
  max-width: 100%;
}
.analysis-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: flex-end;
  justify-content: space-between;
  width: 100%;
}
.analysis-filters-left {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: flex-end;
  flex: 1 1 auto;
  min-width: 0;
  width: 100%;
}
.analysis-filter-field {
  flex: 1 1 140px;
  min-width: 0;
  max-width: 100%;
}
.analysis-mode-toggle {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  width: 100%;
  max-width: 100%;
}
.analysis-subject-row {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--color-bg-base);
  padding: 10px;
  border-radius: var(--radius-md);
  min-width: 0;
  width: 100%;
}
.analysis-subject-row__name {
  flex: 0 1 35%;
  min-width: 0;
  font-size: 13px;
  font-weight: 500;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.analysis-subject-row__bar {
  flex: 1 1 auto;
  min-width: 0;
}
.analysis-subject-row__pct {
  flex: 0 0 auto;
  font-weight: 700;
  font-size: 14px;
  text-align: right;
  white-space: nowrap;
}
.analysis-subject-row__badge {
  flex: 0 0 auto;
}
.analysis-rank-cards {
  display: none;
}
.analysis-rank-table-wrap {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  max-width: 100%;
}
@media screen and (max-width: 640px) {
  .analysis-filters-left {
    flex-direction: column;
    align-items: stretch;
  }
  .analysis-filter-field {
    flex: 1 1 auto;
    width: 100%;
    max-width: 100%;
  }
  .analysis-mode-toggle {
    justify-content: stretch;
  }
  .analysis-mode-toggle button {
    flex: 1 1 auto;
  }
  .analysis-subject-row {
    flex-wrap: wrap;
  }
  .analysis-subject-row__name {
    flex: 1 1 100%;
    white-space: normal;
  }
  .analysis-subject-row__bar {
    flex: 1 1 50%;
  }
  .analysis-rank-table-wrap {
    display: none !important;
  }
  .analysis-rank-cards {
    display: flex !important;
    flex-direction: column;
    gap: 10px;
  }
  .analysis-rank-card {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 12px;
    min-width: 0;
  }
  .analysis-rank-card__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 8px;
  }
  .analysis-rank-card__name {
    font-weight: 700;
    color: var(--color-text-primary);
    font-size: 15px;
    min-width: 0;
    word-break: break-word;
  }
  .analysis-rank-card__meta {
    font-size: 12px;
    color: var(--color-text-secondary);
    margin-top: 2px;
  }
  .analysis-stream-score {
    font-size: 28px !important;
  }
}
